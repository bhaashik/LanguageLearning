# Nonsecret settings only. Copy to .env.YOUR_PROJECT_ID inside this folder.
# Origins have scheme + host + optional port, never /LanguageLearning/.
BHAASA_ALLOWED_ORIGINS=https://bhaashik.github.io,http://127.0.0.1:4173,http://localhost:4173
# Choose exact models available to your project, with the required modalities.
BHAASA_OCR_GEMINI_MODEL=gemini-2.5-flash
BHAASA_ASR_GEMINI_MODEL=gemini-2.5-flash
BHAASA_TTS_GEMINI_MODEL=gemini-2.5-flash-preview-tts
BHAASA_TTS_GEMINI_VOICE=Kore
# BHAASA_GEMINI_API_KEY and BHAASA_GATEWAY_TOKEN go in Firebase secrets,
# not this file. Run functions:secrets:set interactively; see docs/FIREBASE.html.

{
  "name": "bhaasa-malayalam",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "description": "Offline-first Malayalam and French language learning",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "firebase:build": "node firebase/build.mjs",
    "gateway:check": "node firebase/check.mjs",
    "desktop:install": "npm ci --prefix desktop --no-audit --no-fund",
    "desktop:start": "npm run start --prefix desktop",
    "desktop:package": "npm run package --prefix desktop",
    "mobile:install": "npm ci --prefix mobile --no-audit --no-fund",
    "mobile:build": "npm run build --prefix mobile",
    "mobile:sync": "npm run sync --prefix mobile",
    "mobile:android": "npm run android --prefix mobile",
    "mobile:ios": "npm run ios --prefix mobile",
    "speech:install": "npm ci --prefix gateway --no-audit --no-fund",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.12"
  }
}
